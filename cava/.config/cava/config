# cava — https://github.com/karlstav/cava
# Catppuccin Mocha gradient, bottom to top.

[general]
framerate = 60
autosens = 1
bar_width = 2
bar_spacing = 1

[input]
# pulse backend works via pipewire-pulse, follows the default sink.
method = pulse
source = auto

[output]
method = noncurses
channels = stereo

[color]
# default = keep the terminal's background, so transparency shows through.
background = default
gradient = 1
gradient_color_1 = '#94e2d5'
gradient_color_2 = '#89dceb'
gradient_color_3 = '#74c7ec'
gradient_color_4 = '#89b4fa'
gradient_color_5 = '#b4befe'
gradient_color_6 = '#cba6f7'
gradient_color_7 = '#f5c2e7'
gradient_color_8 = '#f38ba8'

[smoothing]
noise_reduction = 45
