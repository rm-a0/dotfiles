# Per-profile launcher. Brave's own picker is the only other way in, and it
# cannot be reached from the command line -- chrome:// URLs passed as argv are
# ignored. Profile dir names are fixed; the display name is set in Brave.
[Desktop Entry]
Type=Application
Name=Brave (Personal)
Exec=rice-brave --profile-directory=Default %U
Icon=brave-browser
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=brave-browser
