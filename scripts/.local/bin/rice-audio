#!/usr/bin/env python3
"""rice-audio — volume and device selection.

Falls back to rice-audio-menu (fuzzel) without GtkLayerShell.
"""

import os
import re
import sys

sys.path.insert(
    0,
    os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"),
)

from rice.panel import RicePanel, run, run_cmd  # noqa: E402

SINK = "@DEFAULT_AUDIO_SINK@"
SOURCE = "@DEFAULT_AUDIO_SOURCE@"

I_VOL = "\uf028"           # nf-fa-volume_up
I_MUTE = "\uf026"          # nf-fa-volume_off
I_MIC = "\uf130"           # nf-fa-microphone
I_MIC_OFF = "\uf131"       # nf-fa-microphone_slash

# Matches a `wpctl status` device row:  │  *   58. Some Name [vol: 0.35]
ROW = re.compile(r"^\s*[│├└─\s]*(\*?)\s*(\d+)\.\s+(.*?)\s+\[vol:", re.UNICODE)


def wpctl(*args):
    return run_cmd("wpctl", *args)


def get_volume(target):
    out = wpctl("get-volume", target)
    m = re.search(r"([0-9]+\.[0-9]+)", out)
    return (int(round(float(m.group(1)) * 100)) if m else 0), ("MUTED" in out)


def devices(section):
    out = wpctl("status")
    block, found = [], False
    for line in out.splitlines():
        if re.search(rf"─\s*{section}:", line):
            found = True
            continue
        if found:
            if re.search(r"─\s*\w+:", line):
                break
            block.append(line)
    return [
        (m.group(2), m.group(3).strip(), "*" in line)
        for line in block
        if (m := ROW.match(line))
    ]


def shorten(names):
    """Drop the shared controller prefix from each device name.

    Grouped by first word: a common prefix across all of them is often empty
    (a USB dock shares nothing with the built-ins), and trimming by the
    longest shared with any other over-corrects.
    """
    if len(names) < 2:
        return names

    groups = {}
    for idx, name in enumerate(names):
        parts = name.split()
        groups.setdefault(parts[0] if parts else "", []).append(idx)

    out = list(names)
    for members in groups.values():
        if len(members) < 2:
            continue
        words = [names[i].split() for i in members]
        prefix = 0
        for column in zip(*words):
            if len(set(column)) == 1:
                prefix += 1
            else:
                break
        for i, w in zip(members, words):
            out[i] = " ".join(w[min(prefix, len(w) - 1):])
    return out


class AudioPanel(RicePanel):
    NAME = "rice-audio"

    def build(self, box):
        self.header(box, I_VOL, "Sound")

        self.heading(box, "OUTPUT")
        self._section(box, SINK, I_VOL, I_MUTE, "Sinks")

        self.separator(box)

        self.heading(box, "INPUT")
        self._section(box, SOURCE, I_MIC, I_MIC_OFF, "Sources")

        self.separator(box)
        self.settings_button(box, "Sound settings", ["pavucontrol"])

    def _section(self, box, target, on_glyph, off_glyph, section):
        pct, muted = get_volume(target)

        def on_change(value, label):
            label.set_text(f"{value:3d}%")
            wpctl("set-volume", target, f"{value}%")

        def on_mute(_button, icon, scale):
            wpctl("set-mute", target, "toggle")
            _, now_muted = get_volume(target)
            icon.set_text(off_glyph if now_muted else on_glyph)
            ctx = icon.get_style_context()
            (ctx.add_class if now_muted else ctx.remove_class)("muted")
            scale.set_sensitive(not now_muted)

        icon, scale, _ = self.slider_row(
            box, off_glyph if muted else on_glyph, pct, on_change, on_mute
        )
        if muted:
            icon.get_style_context().add_class("muted")
            scale.set_sensitive(False)

        entries = devices(section)
        if entries:
            labels = shorten([name for _, name, _ in entries])
            self.select_list(
                box,
                [(i, lbl, d) for (i, _, d), lbl in zip(entries, labels)],
                lambda dev_id: wpctl("set-default", dev_id),
            )


if __name__ == "__main__":
    run(AudioPanel, fallback="rice-audio-menu")
