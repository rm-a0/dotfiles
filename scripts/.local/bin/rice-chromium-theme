#!/usr/bin/env python3
"""rice-chromium-theme — generate a Chromium theme extension from the accent.

Chromium has no userChrome.css; the only supported hook into browser UI is a
theme extension, which is a directory holding a manifest and nothing else.
So unlike rice-discord-theme there is nothing to fetch -- the manifest is
built here from Mocha plus the current accent.

The extension lives outside the dotfiles repo because Chromium rewrites
nothing in it but the profile must point at a stable path:

    ~/.local/share/rice/chromium-theme/manifest.json

Load it once per profile via chrome://extensions -> Load unpacked. After
that it is remembered; regenerating this file and restarting Chromium (or
hitting Reload on the card) re-applies it.

    rice-chromium-theme              follow ~/.local/state/rice/accent
    rice-chromium-theme <hex>        use a specific colour
    rice-chromium-theme --path       print the directory to load
"""

import json
import os
import pathlib
import re
import shutil
import sys

HOME = pathlib.Path.home()
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "rice"
DATA = pathlib.Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "rice"
THEME_DIR = DATA / "chromium-theme"
MANIFEST = THEME_DIR / "manifest.json"

DEFAULT_ACCENT = "cba6f7"      # mauve

# Catppuccin Mocha. Only the accent is substituted; the base never moves.
MOCHA = {
    "text":     "cdd6f4",
    "subtext0": "a6adc8",
    "overlay1": "7f849c",
    "surface1": "45475a",
    "surface0": "313244",
    "base":     "1e1e2e",
    "mantle":   "181825",
    "crust":    "11111b",
}


def rgb(hex_colour):
    """'cba6f7' -> [203, 166, 247]. Chromium theme colours are int triples."""
    return [int(hex_colour[i:i + 2], 16) for i in (0, 2, 4)]


def manifest(accent):
    c = MOCHA
    return {
        "manifest_version": 3,
        "name": "rice-accent",
        "version": "1.0",
        "description": "Catppuccin Mocha, generated by rice-chromium-theme.",
        "theme": {
            "colors": {
                # Window frame: mantle, so the active tab (toolbar/base)
                # reads as raised rather than flush.
                "frame":                       rgb(c["mantle"]),
                "frame_inactive":              rgb(c["crust"]),
                "frame_incognito":             rgb(c["crust"]),
                "frame_incognito_inactive":    rgb(c["crust"]),

                "toolbar":                     rgb(c["base"]),

                "tab_text":                    rgb(c["text"]),
                "tab_background_text":         rgb(c["subtext0"]),
                "tab_background_text_inactive": rgb(c["overlay1"]),

                "bookmark_text":               rgb(c["text"]),
                "toolbar_button_icon":         rgb(c["subtext0"]),

                # The omnibox is the one large surface that should sit above
                # the toolbar rather than in it.
                "omnibox_background":          rgb(c["surface0"]),
                "omnibox_text":                rgb(c["text"]),

                "ntp_background":              rgb(c["base"]),
                "ntp_text":                    rgb(c["text"]),
                "ntp_link":                    rgb(accent),

                "button_background":           rgb(c["surface1"]),
            },
            # Chromium picks a dark-on-light logo unless told otherwise.
            "properties": {"ntp_logo_alternate": 1},
        },
    }


def dump(obj):
    """Pretty JSON, but with the colour triples kept on one line -- indent=2
    would spread every [r, g, b] over four, and this file is meant to be read.
    """
    text = json.dumps(obj, indent=2)
    return re.sub(r"\[\s*(\d+),\s*(\d+),\s*(\d+)\s*\]",
                  r"[\1, \2, \3]", text) + "\n"


def current_accent():
    try:
        value = (STATE / "accent").read_text().split()[0]
    except (OSError, IndexError):
        return DEFAULT_ACCENT
    return value if re.fullmatch(r"[0-9a-fA-F]{6}", value) else DEFAULT_ACCENT


def main():
    args = sys.argv[1:]

    if args and args[0] == "--path":
        print(THEME_DIR)
        return

    # Don't scatter directories for a browser that isn't installed. Any
    # Chromium-family browser loads the same unpacked theme, Brave included.
    browsers = ("chromium", "chrome", "brave-browser", "brave")
    if not any(shutil.which(b) for b in browsers):
        print("rice-chromium-theme: no chromium-family browser installed, "
              "nothing to do")
        return

    accent = args[0].lstrip("#") if args else current_accent()
    if not re.fullmatch(r"[0-9a-fA-F]{6}", accent):
        sys.exit(f"rice-chromium-theme: not a hex colour: {accent}")

    body = dump(manifest(accent))

    existed = MANIFEST.exists()
    if existed and MANIFEST.read_text() == body:
        print(f"accent #{accent} -> chromium theme (already current)")
        return

    THEME_DIR.mkdir(parents=True, exist_ok=True)
    # Temp file first -- a half-written manifest is an extension that will
    # not load, and Chromium disables it rather than retrying.
    tmp = MANIFEST.with_suffix(".tmp")
    tmp.write_text(body)
    tmp.replace(MANIFEST)

    print(f"accent #{accent} -> chromium theme  ({MANIFEST})")
    if not existed:
        print("\nLoad it once per profile:")
        print("  chrome://extensions -> Developer mode -> Load unpacked")
        print(f"  {THEME_DIR}")
    else:
        print("Restart Chromium, or hit Reload on the card in "
              "chrome://extensions.")


if __name__ == "__main__":
    main()
