#!/usr/bin/env python3
"""rice-wifi — network list under the bar's network module.

Falls back to rice-wifi-menu (fuzzel) without GtkLayerShell.
"""

import os
import sys
import tempfile

sys.path.insert(
    0,
    os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"),
)

from rice.panel import (  # noqa: E402
    REFRESH, RicePanel, notify, run, run_async, run_cmd,
)

I_WIFI = "\uf1eb"          # nf-fa-wifi
I_LOCK = "\uf023"          # nf-fa-lock
I_OFF = "\U000f092f"       # nf-md-wifi_off

# Signal strength, weakest first.
I_BARS = [
    "\U000f092d",          # nf-md-wifi_strength_outline
    "\U000f091f",          # nf-md-wifi_strength_1
    "\U000f0922",          # nf-md-wifi_strength_2
    "\U000f0925",          # nf-md-wifi_strength_3
    "\U000f0928",          # nf-md-wifi_strength_4
]

MAX_ROWS = 7             # beyond this the list scrolls
RESCAN = ["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
          "device", "wifi", "list", "--rescan", "yes"]
TIMEOUT = 20             # seconds; nmcli's default wait is 90


def nm_split(line):
    r"""Split one `nmcli -t` row: it escapes `:` and `\` inside fields."""
    fields, current, escaped = [], [], False
    for char in line:
        if escaped:
            current.append(char)
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(char)
    fields.append("".join(current))
    return fields


def radio_on():
    return run_cmd("nmcli", "-t", "-f", "WIFI", "radio").strip() == "enabled"


def saved_profiles():
    return {
        nm_split(line)[0]
        for line in run_cmd("nmcli", "-t", "-f", "NAME", "connection", "show").splitlines()
        if line
    }


def key_mgmt(security):
    """nmcli SECURITY column to a profile key-mgmt; None if not PSK/SAE."""
    if "802.1X" in security or "WPA" not in security:
        return None
    if "WPA3" in security and "WPA1" not in security and "WPA2" not in security:
        return "sae"
    return "wpa-psk"


def connect_secured(ssid, mgmt, password):
    """Profile first, key second, through a private file: argv is readable
    by every user via /proc. Returns `connection up`'s stdout.
    """
    run_cmd("nmcli", "connection", "add", "type", "wifi", "con-name", ssid,
            "ssid", ssid, "wifi-sec.key-mgmt", mgmt, "connection.autoconnect", "no")
    fd, path = tempfile.mkstemp(dir=os.environ.get("XDG_RUNTIME_DIR"))
    try:
        with os.fdopen(fd, "w") as f:
            f.write(f"802-11-wireless-security.psk:{password}\n")
        out = run_cmd("nmcli", "-w", str(TIMEOUT), "connection", "up", "id", ssid,
                      "passwd-file", path)
    finally:
        os.unlink(path)
    if "successful" in out.lower():
        run_cmd("nmcli", "connection", "modify", "id", ssid, "connection.autoconnect", "yes")
    else:
        # A keyless profile left behind would skip the prompt next time.
        run_cmd("nmcli", "connection", "delete", "id", ssid)
    return out


def parse_networks(output):
    """[(ssid, signal, security, active)], strongest first, one row per SSID.

    security is nmcli's SECURITY column, '' for an open network.

    nmcli lists an SSID once per AP; collapse to the strongest, keeping the
    in-use mark even when that is on a weaker one.
    """
    best = {}
    for line in output.splitlines():
        if not line:
            continue
        fields = nm_split(line)
        if len(fields) < 4:
            continue
        in_use, ssid, signal, security = fields[0], fields[1], fields[2], fields[3]
        if not ssid:
            continue                      # hidden network, no name to show
        try:
            signal = int(signal)
        except ValueError:
            signal = 0
        if security == "--":
            security = ""

        previous = best.get(ssid)
        if previous is None or signal > previous[1]:
            best[ssid] = (ssid, signal, security, previous[3] if previous else False)
        if in_use == "*":
            entry = best[ssid]
            best[ssid] = (entry[0], entry[1], entry[2], True)

    return sorted(best.values(), key=lambda n: (not n[3], -n[1]))


def scan(force=False):
    """The network list. force=True hits the radio; otherwise cached.

    Cached opens instantly; anything else blocks before the window maps.
    A background rescan follows.
    """
    return run_cmd(
        "nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY",
        "device", "wifi", "list", "--rescan", "yes" if force else "no",
    )


class WifiPanel(RicePanel):
    NAME = "rice-wifi"

    def __init__(self):
        # busy = show a spinner; ask = SSID awaiting a password.
        self.busy = None
        self.ask = None
        on = radio_on()
        self.networks = parse_networks(scan()) if on else []
        super().__init__()

        # Fresh scan after the window is up, swapped in when it lands.
        if on:
            run_async(RESCAN, self.auto_scanned)

    # ---- layout -------------------------------------------------------
    def build(self, box):
        on = radio_on()
        self.header(box, I_WIFI if on else I_OFF, "Wi-Fi",
                    active=on, on_toggle=self.set_radio)

        if not on:
            self.info_row(box, "Wi-Fi is turned off", "", dim=True)
        elif self.busy:
            self.spinner_row(box, self.busy)
        elif self.ask:
            self.heading(box, "PASSWORD")
            self.info_row(box, self.ask, "", dim=True)
            self.entry_row(box, "Network password", self.connect_with_password,
                           password=True)
        else:
            self.heading(box, "NETWORKS")
            if self.networks:
                self.select_list(
                    box,
                    [(ssid, ssid, active, bars(signal),
                      f"{signal}% {I_LOCK if security else ' '}")
                     for ssid, signal, security, active in self.networks],
                    self.on_pick,
                    max_visible=MAX_ROWS,
                )
            else:
                self.info_row(box, "no networks found", "", dim=True)

        self.separator(box)
        if on and not self.busy:
            self.action_row(box, REFRESH, "Rescan", self.rescan)
        self.settings_button(box, "Network settings", ["nm-connection-editor"])

    # ---- actions ------------------------------------------------------
    def set_radio(self, wanted):
        if self.busy or wanted == radio_on():
            return
        self.start("Turning Wi-Fi on…" if wanted else "Turning Wi-Fi off…",
                   ["nmcli", "radio", "wifi", "on" if wanted else "off"],
                   lambda _out: self.reload(force=wanted))

    def rescan(self):
        self.start("Scanning…", RESCAN, self.scanned)

    def auto_scanned(self, output):
        """The background rescan landed. Drop it if the user has moved on."""
        if self.busy or self.ask:
            return
        networks = parse_networks(output)
        if networks:
            self.networks = networks
            self.refresh()

    def scanned(self, output):
        self.busy = None
        self.networks = parse_networks(output)
        self.refresh()

    def reload(self, force=False):
        self.busy = None
        self.ask = None
        self.networks = parse_networks(scan(force)) if radio_on() else []
        self.refresh()

    def on_pick(self, ssid):
        current = next((n for n in self.networks if n[0] == ssid), None)
        if current is None:
            return
        _, _, security, active = current

        if active:
            self.start(f"Disconnecting from {ssid}…",
                       ["nmcli", "connection", "down", "id", ssid],
                       lambda out: self.done(out, ssid, "Disconnected",
                                             "Failed to disconnect"))
        elif ssid in saved_profiles():
            # A saved profile holds the key already; no need to ask again.
            self.start(f"Connecting to {ssid}…",
                       ["nmcli", "-w", str(TIMEOUT), "connection", "up", "id", ssid],
                       lambda out: self.done(out, ssid, "Connected",
                                             "Failed to connect"))
        elif security:
            if key_mgmt(security) is None:
                # Enterprise and WEP need more than one password field.
                self.finish("Set up in Network settings", ssid, False)
                return
            # nmcli with no secrets agent hangs until it times out.
            self.ask = ssid
            self.refresh()
        else:
            self.start(f"Connecting to {ssid}…",
                       ["nmcli", "-w", str(TIMEOUT), "device", "wifi", "connect", ssid],
                       lambda out: self.done(out, ssid, "Connected",
                                             "Failed to connect"))

    def connect_with_password(self, password):
        ssid, self.ask = self.ask, None
        if not password:
            self.reload()
            return
        security = next((n[2] for n in self.networks if n[0] == ssid), "")
        mgmt = key_mgmt(security) or "wpa-psk"
        self.start(f"Connecting to {ssid}…",
                   lambda: connect_secured(ssid, mgmt, password),
                   lambda out: self.done(out, ssid, "Connected",
                                         "Failed to connect"))

    def start(self, message, command, on_done):
        """Show the spinner, run the command off the main loop."""
        self.busy = message
        self.refresh()
        run_async(command, on_done)

    def done(self, output, ssid, ok_message, fail_message):
        # nmcli puts success on stdout, every failure on stderr.
        ok = "successful" in output.lower()
        self.finish(ok_message if ok else fail_message, ssid, ok)

    def finish(self, summary, ssid, ok):
        notify("Wi-Fi", summary, ssid)
        if ok:
            self.dismiss()
        else:
            self.reload()


def bars(signal):
    """Signal percentage to one of five strength glyphs."""
    return I_BARS[min(len(I_BARS) - 1, max(0, signal * len(I_BARS) // 101))]


if __name__ == "__main__":
    run(WifiPanel, fallback="rice-wifi-menu")
