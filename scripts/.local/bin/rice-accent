#!/usr/bin/env python3
"""rice-accent — derive an accent colour from the current wallpaper.

Opt-in. The Mocha base never changes; only the accent does. Each target gets
a small generated fragment that its hand-written config pulls in, so no
tracked file is ever rewritten.

    target            fragment                        pulled in by
    waybar            waybar/accent.css               @import
    GTK 3 / GTK 4     gtk-{3.0,4.0}/accent.css        @import
    wlogout           wlogout/accent.css              @import
    hyprlock          hypr/accent.conf                source=
    mako              mako/accent                     include=
    zathura           zathura/accent                  include
    fuzzel            fuzzel/accent.ini               include=
    Hyprland border   ~/.local/state/rice/accent      lua/theme.lua
    rice-* panels     ~/.local/state/rice/accent      panel.py
    Discord/Vencord   Vencord/themes/                 rice-discord-theme

Where the format has variables (CSS, hyprlang) the fragment defines them.
Where it does not (mako, fuzzel, zathura), it owns those keys outright --
otherwise whichever was parsed last would win.

    rice-accent from <image>   derive and apply
    rice-accent reset          back to Catppuccin mauve
    rice-accent auto on|off    whether rice-wallpaper applies it on switch
    rice-accent status         show current accent and auto setting
"""

import colorsys
import os
import pathlib
import re
import subprocess
import sys

HOME = pathlib.Path.home()
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "rice"
ACCENT_FILE = STATE / "accent"
AUTO_FLAG = STATE / "accent-auto"
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))

# Catppuccin Mocha defaults.
DEFAULT_ACCENT = "cba6f7"      # mauve
DEFAULT_ALT = "b4befe"         # lavender
BASE_L = 0.12                  # lightness of Mocha base #1e1e2e


def die(msg):
    print(f"rice-accent: {msg}", file=sys.stderr)
    sys.exit(1)


def histogram(image, n=16):
    """(count, r, g, b) for the n dominant colours, via ImageMagick."""
    try:
        out = subprocess.run(
            ["magick", str(image), "-resize", "200x200>", "-colors", str(n),
             "-format", "%c", "histogram:info:-"],
            capture_output=True, text=True, check=True).stdout
    except FileNotFoundError:
        die("ImageMagick (magick) is required")
    except subprocess.CalledProcessError as e:
        die(f"could not read {image}: {e.stderr.strip()}")

    # Lines look like:
    #     2615: (17.07,19.7549,44.4669) #11142C srgb(6.69%,7.74%,17.43%)
    # The parenthesised channels are floats and their scale varies with the
    # build's quantum depth, so parse the hex field -- it is always 8-bit
    # per channel. PNGs with alpha yield #RRGGBBAA; the alpha is discarded.
    colours = []
    for line in out.splitlines():
        m = re.search(r"(\d+)\s*:.*?#([0-9A-Fa-f]{6})(?:[0-9A-Fa-f]{2})?\b", line)
        if m:
            cnt = int(m.group(1))
            hexv = m.group(2)
            r, g, b = (int(hexv[i:i + 2], 16) / 255 for i in (0, 2, 4))
            colours.append((cnt, r, g, b))
    return colours


def pick(colours):
    """Pick a saturated, mid-to-light colour that reads against a dark base.

    Frequency counts for little: the commonest colour in a wallpaper is
    almost always the dark background.
    """
    total = sum(c[0] for c in colours) or 1
    best, best_score = None, -1.0

    for cnt, r, g, b in colours:
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        share = cnt / total

        if abs(l - BASE_L) < 0.18:      # too close to the base to be visible
            continue
        if s < 0.15:                    # greyscale wallpapers have no accent
            continue

        # Peak desirability around l=0.6: bright enough to read on #1e1e2e,
        # not so bright it glares.
        lightness_fit = 1.0 - min(abs(l - 0.60) / 0.45, 1.0)
        score = (s ** 1.5) * lightness_fit * (0.25 + 0.75 * share ** 0.35)

        if score > best_score:
            best, best_score = (h, l, s), score

    if best is None:
        return None

    # Normalise so every wallpaper yields a usable accent, however muted.
    h, l, s = best
    s = max(s, 0.45)
    l = min(max(l, 0.62), 0.78)
    return h, l, s


def hexof(h, l, s):
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return "".join(f"{int(round(v * 255)):02x}" for v in (r, g, b))


BANNER = "Generated by rice-accent. Edit rice-accent, not this file."


def fragments(accent, alt):
    """{path: text} for every generated fragment."""
    css = (f"/* {BANNER} */\n"
           f"@define-color accent    #{accent};\n"
           f"@define-color accentAlt #{alt};\n")

    return {
        CONFIG / "waybar" / "accent.css": css,
        CONFIG / "wlogout" / "accent.css": css,
        CONFIG / "gtk-3.0" / "accent.css": css,
        CONFIG / "gtk-4.0" / "accent.css": css,

        CONFIG / "hypr" / "accent.conf":
            f"# {BANNER}\n"
            f"$accent = rgba({accent}ff)\n"
            f"$alt    = rgba({alt}ff)\n",

        # Global; the urgency criteria in mako/config override it.
        CONFIG / "mako" / "accent":
            f"# {BANNER}\n"
            f"border-color=#{accent}\n",

        # zathura resolves relative includes against zathurarc.
        CONFIG / "zathura" / "accent":
            f"# {BANNER}\n"
            f'set highlight-color            "#{accent}"\n'
            f'set highlight-active-color     "#{alt}"\n'
            f'set index-active-bg            "#{accent}"\n'
            f'set completion-highlight-bg    "#{accent}"\n'
            f'set completion-highlight-fg    "#11111b"\n',

        # The include does not inherit the section it was written in.
        CONFIG / "fuzzel" / "accent.ini":
            f"# {BANNER}\n"
            "[colors]\n"
            f"match={accent}ff\n"
            f"selection-match={accent}ff\n"
            f"border={accent}ff\n",
    }


def write_fragments(accent, alt):
    for path, text in fragments(accent, alt).items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)


def reload_all():
    """Push the colour to whatever can take it live.

    fuzzel, wlogout and the panels re-read on launch. GTK apps need a restart.
    """
    subprocess.run(["systemctl", "--user", "restart", "waybar"],
                   capture_output=True)
    subprocess.run(["makoctl", "reload"], capture_output=True)
    subprocess.run(["hyprctl", "reload"], capture_output=True)

    # Swaps a file rather than rewriting a colour, and hits the network --
    # hence last. No-op unless the nearest accent changed.
    subprocess.run(["rice-discord-theme"], capture_output=True)


def apply(accent, alt):
    STATE.mkdir(parents=True, exist_ok=True)
    ACCENT_FILE.write_text(f"{accent}\n{alt}\n")
    write_fragments(accent, alt)
    reload_all()
    print(f"accent #{accent}  alt #{alt}")


def main():
    args = sys.argv[1:] or ["status"]
    cmd = args[0]

    if cmd == "from":
        if len(args) < 2:
            die("usage: rice-accent from <image>")
        img = pathlib.Path(args[1]).expanduser().resolve()
        if not img.is_file():
            die(f"no such image: {img}")
        chosen = pick(histogram(img))
        if chosen is None:
            print("rice-accent: no usable accent in image "
                  "(greyscale or too dark) -- keeping Catppuccin mauve",
                  file=sys.stderr)
            apply(DEFAULT_ACCENT, DEFAULT_ALT)
            return
        h, l, s = chosen
        apply(hexof(h, l, s), hexof(h, min(l + 0.10, 0.88), max(s - 0.18, 0.30)))

    elif cmd == "reset":
        apply(DEFAULT_ACCENT, DEFAULT_ALT)

    elif cmd == "seed":
        # For install.sh. A missing fragment is not a missing colour, it is
        # a config that fails to parse. Writes only what is absent.
        current = DEFAULT_ACCENT, DEFAULT_ALT
        if ACCENT_FILE.exists():
            saved = ACCENT_FILE.read_text().split()
            if len(saved) >= 2:
                current = saved[0], saved[1]
        missing = {p: t for p, t in fragments(*current).items() if not p.exists()}
        for path, text in missing.items():
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
        print(f"seeded {len(missing)} accent fragment(s)")

    elif cmd == "auto":
        if len(args) < 2 or args[1] not in ("on", "off"):
            die("usage: rice-accent auto on|off")
        STATE.mkdir(parents=True, exist_ok=True)
        if args[1] == "on":
            AUTO_FLAG.touch()
        else:
            AUTO_FLAG.unlink(missing_ok=True)
        print(f"auto accent: {args[1]}")

    elif cmd == "status":
        if ACCENT_FILE.exists():
            lines = ACCENT_FILE.read_text().split()
            print(f"accent: #{lines[0]}  alt: #{lines[1] if len(lines) > 1 else '?'}")
        else:
            print(f"accent: #{DEFAULT_ACCENT} (default, not yet applied)")
        print(f"auto:   {'on' if AUTO_FLAG.exists() else 'off'}")

    else:
        die(f"unknown command: {cmd} (try: from reset seed auto status)")


if __name__ == "__main__":
    main()
