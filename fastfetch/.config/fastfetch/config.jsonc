// fastfetch — https://github.com/fastfetch-cli/fastfetch
//
// Run via `rice-fetch`, which adds the accent and drops the logo in narrow
// windows. Debian's build silently falls back to ASCII for every image logo
// type despite listing imagemagick7 and chafa, so the built-in one is used.
// os/cpu/gpu/disk/display are trimmed to keep the block under 77 columns.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type":    "builtin",
        "source":  "debian",
        "padding": { "top": 1, "left": 2, "right": 2 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "magenta", "title": "blue" },
        "key": { "width": 11 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "separator", "string": "─" },
        { "type": "os",      "key": "  os",    "keyColor": "magenta", "format": "{2} {8}" },
        { "type": "kernel",  "key": "  kernel","keyColor": "magenta" },
        { "type": "uptime",  "key": "  uptime","keyColor": "magenta" },
        { "type": "packages","key": "  pkgs",  "keyColor": "magenta" },
        { "type": "shell",   "key": "  shell", "keyColor": "magenta" },
        { "type": "wm",      "key": "  wm",    "keyColor": "blue" },
        { "type": "terminal","key": "  term",  "keyColor": "blue" },
        { "type": "display", "key": "  res",   "keyColor": "blue", "format": "{1}x{2} @ {3} Hz" },
        { "type": "cpu",     "key": "  cpu",   "keyColor": "green", "format": "{1}" },
        { "type": "gpu",     "key": "  gpu",   "keyColor": "green", "format": "{2}" },
        { "type": "memory",  "key": "  mem",   "keyColor": "green" },
        { "type": "disk",    "key": "  disk",  "keyColor": "green", "format": "{1} / {2} ({3})" },
        { "type": "battery", "key": "  bat",   "keyColor": "yellow" },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break"
    ]
}
