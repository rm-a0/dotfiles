# Catppuccin Mocha for btop — https://github.com/catppuccin/catppuccin
#
# main_bg empty = keep the terminal background, so transparency shows through.
# Gradients are semantic (green -> yellow -> red), not accent-following.

theme[main_bg]=""
theme[main_fg]="#cdd6f4"
theme[title]="#cdd6f4"
theme[hi_fg]="#cba6f7"
theme[selected_bg]="#313244"
theme[selected_fg]="#cdd6f4"
theme[inactive_fg]="#6c7086"
theme[graph_text]="#a6adc8"
theme[meter_bg]="#313244"
theme[proc_misc]="#94e2d5"

theme[cpu_box]="#45475a"
theme[mem_box]="#45475a"
theme[net_box]="#45475a"
theme[proc_box]="#45475a"
theme[div_line]="#45475a"

# Temperature: cool -> warm -> hot
theme[temp_start]="#94e2d5"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU load
theme[cpu_start]="#a6e3a1"
theme[cpu_mid]="#f9e2af"
theme[cpu_end]="#f38ba8"

# Memory: free / cached / available / used
theme[free_start]="#a6e3a1"
theme[free_mid]="#a6e3a1"
theme[free_end]="#a6e3a1"
theme[cached_start]="#89b4fa"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#89b4fa"
theme[available_start]="#f9e2af"
theme[available_mid]="#f9e2af"
theme[available_end]="#f9e2af"
theme[used_start]="#f38ba8"
theme[used_mid]="#f38ba8"
theme[used_end]="#f38ba8"

# Network
theme[download_start]="#89b4fa"
theme[download_mid]="#74c7ec"
theme[download_end]="#94e2d5"
theme[upload_start]="#f5c2e7"
theme[upload_mid]="#cba6f7"
theme[upload_end]="#b4befe"

# Process CPU gradient
theme[process_start]="#a6e3a1"
theme[process_mid]="#f9e2af"
theme[process_end]="#f38ba8"
