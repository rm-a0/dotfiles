# mako — https://github.com/emersion/mako
# No fixed `height`: it silently truncates longer notifications.

font=JetBrainsMono Nerd Font Mono 10
layer=overlay
anchor=top-right
sort=-time

width=360
margin=10
padding=14
border-size=1
border-radius=14
max-icon-size=48
icon-location=left

background-color=#1e1e2edb
text-color=#cdd6f4
# Generated by rice-accent. Urgency criteria below override it.
include=~/.config/mako/accent
progress-color=over #45475a

default-timeout=6000
ignore-timeout=0
max-visible=5
group-by=app-name

markup=1
format=<b>%s</b>\n%b
actions=1

[urgency=low]
border-color=#45475a
text-color=#a6adc8
default-timeout=4000

[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

[app-name=Wallpaper]
default-timeout=2500

[app-name=Screenshot]
default-timeout=3000
